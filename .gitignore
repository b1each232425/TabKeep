# === 前端 Extension 忽略项 ===
extension/.plasmo/
extension/build/
extension/node_modules/
extension/.env*
!extension/.env.example
extension/*.local
extension/tsconfig*.tsbuildinfo

# === 桌面端 Tauri 忽略项 ===
desktop/node_modules/
desktop/dist/
desktop/.vite/
desktop/.env*
!desktop/.env.example
desktop/*.local
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/tsconfig*.tsbuildinfo

# === 后端 Python 忽略项 ===
__pycache__/
*.pyc
.venv/
venv/
env/
.env
backend/.env*
!backend/.env.example

# === 后端运行时数据（config.json 含明文 apiKey/token，不提交） ===
backend/data/
backend/logs/

# === 通用构建缓存 / 日志 / 临时文件 ===
*.tsbuildinfo
*.log
*.tmp
*.temp
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.cache/
.tmp/
tmp/
temp/

# === 系统与编辑器残渣 ===
.DS_Store
.vscode/
保存效果.md
TABKEEP_RAG_TECH_SELECTION.md
